{
  "name": "juris-banking-settlement-payment-automation",
  "version": "1.0.0",
  "description": "Automated Payment Distribution System for Legal Settlement Administration",
  "license": "SEE LICENSE IN LICENSE",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "test:server": "npm run test --workspace=server",
    "test:client": "npm run test --workspace=client",
    "test:e2e": "node tests/e2e/run_all.js",
    "start": "npm run start --workspace=server"
  }
}
