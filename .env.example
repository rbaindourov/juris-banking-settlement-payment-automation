# ==============================================================================
# JURIS-BANKING: MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment & Server Ports
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# MongoDB Native Database Connection (MongoDB 7.0 native on host)
MONGODB_URI=mongodb://localhost:27017/juris_banking
MONGODB_URI_TEST=mongodb://localhost:27017/juris_banking_test

# JWT Authentication & Cookie Security
JWT_SECRET=super_secure_jwt_secret_change_in_production_min32chars_long!
JWT_EXPIRES_IN=24h
COOKIE_SECRET=super_secure_cookie_secret_change_in_production_min32chars!
SALT_ROUNDS=10

# Agenda Job Scheduler
AGENDA_DB_COLLECTION=agendaJobs
AGENDA_PROCESS_EVERY=5 seconds
AGENDA_MAX_CONCURRENCY=20

# Pluggable Email Engine (mock | ethereal | smtp | sendgrid | ses)
EMAIL_TRANSPORT=mock
EMAIL_FROM=Settlement Administrator <disbursements@juris-banking.local>

# Production SMTP Config (if EMAIL_TRANSPORT=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mg.domain.com
SMTP_PASS=smtp_password_here

# SendGrid / AWS SES Config
SENDGRID_API_KEY=SG.your_api_key_here
AWS_SES_REGION=us-east-1
AWS_SES_USER=ses_smtp_username
AWS_SES_PASS=ses_smtp_password

# Dash Solutions SFTP Connection
SFTP_HOST=127.0.0.1
SFTP_PORT=2222
SFTP_USER=dash_user
SFTP_PASS=dash_pass
SFTP_PRIVATE_KEY_PATH=
SFTP_REMOTE_INBOUND_DIR=/inbound/disbursements
SFTP_REMOTE_OUTBOUND_DIR=/outbound/reports
SFTP_LOCAL_STORAGE_DIR=storage/sftp

# Mock SFTP Test Server
MOCK_SFTP_PORT=2222
MOCK_SFTP_USER=dash_user
MOCK_SFTP_PASS=dash_pass
